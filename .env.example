# Copy to .env.local and fill in. Never commit real values (Tech.md §10, "Hosting i mejl").

# Supabase (client and server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Supabase service key (server only, used only by lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Email via Resend (server only; EMAIL_MODE stays "test")
RESEND_API_KEY=
EMAIL_MODE=
TEST_INBOX=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Demo accounts password (.env.local only, used by scripts/; not on Vercel)
DEMO_PASSWORD=
